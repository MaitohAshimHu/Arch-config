#!/bin/bash

FILE="$HOME/Pictures/Screenshots/$(date +%Y-%m-%d-%H-%M-%S)-window.png"

WINDOW=$(xdotool getactivewindow)

if maim -i "$WINDOW" "$FILE"; then
    xclip -selection clipboard -t image/png -i "$FILE"
    notify-send -t 1200 "Screenshot copied" "Window saved and ready to paste with Ctrl+V"
fi
